{
  "name": "@keicoin/economy",
  "version": "0.2.3",
  "description": "Declarative game-economy recipes for Kei: rewards, sinks, and atomic shop/craft exchanges, with a dry run before anything is signed.",
  "license": "MIT",
  "author": "Sano",
  "homepage": "https://keicoin.org#economy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keicoin-org/kei-transaction.git",
    "directory": "packages/economy"
  },
  "bugs": {
    "url": "https://github.com/keicoin-org/kei-transaction/issues"
  },
  "keywords": [
    "kei",
    "game-economy",
    "recipes",
    "crafting",
    "shop",
    "loot",
    "sink",
    "faucet"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "tsc --build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@keicoin/claims": "^0.7.0",
    "@keicoin/core": "^0.7.0",
    "@keicoin/market": "^0.6.0"
  }
}
