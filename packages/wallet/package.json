{
  "name": "@keicoin/wallet",
  "version": "0.4.1",
  "description": "In-game wallet for Kei: mountable balance/inventory/claims panel, plus the headless summary API underneath it.",
  "license": "MIT",
  "author": "Sano",
  "homepage": "https://keicoin.org#wallet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keicoin-org/kei-transaction.git",
    "directory": "packages/wallet"
  },
  "bugs": {
    "url": "https://github.com/keicoin-org/kei-transaction/issues"
  },
  "keywords": [
    "kei",
    "wallet",
    "inventory",
    "game",
    "balances"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@keicoin/claims": "^0.4.0",
    "@keicoin/core": "^0.4.0",
    "@keicoin/tokens": "^0.5.0"
  }
}
