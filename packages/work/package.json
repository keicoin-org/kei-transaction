{
  "name": "@keicoin/work",
  "version": "0.4.2",
  "description": "Proof-of-work for Kei blocks: difficulty tiers, local generation, work-server client.",
  "license": "MIT",
  "author": "Sano",
  "homepage": "https://keicoin.org#work",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keicoin-org/kei-transaction.git",
    "directory": "packages/work"
  },
  "bugs": {
    "url": "https://github.com/keicoin-org/kei-transaction/issues"
  },
  "keywords": [
    "kei",
    "proof-of-work",
    "nano",
    "banano",
    "blake2b"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "bun": "./src/server.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "kei-work-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "tsc --build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@keicoin/core": "^0.6.0"
  }
}
