{
  "name": "@keicoin/player-economy",
  "version": "0.1.1",
  "description": "Noncustodial player shops for Kei: list, buy, cancel, and gift through the player's own wallet, with honest pending state and chart-ready history.",
  "license": "MIT",
  "author": "Sano",
  "homepage": "https://keicoin.org#player-economy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keicoin-org/kei-transaction.git",
    "directory": "packages/player-economy"
  },
  "bugs": {
    "url": "https://github.com/keicoin-org/kei-transaction/issues"
  },
  "keywords": [
    "kei",
    "player-economy",
    "player-shop",
    "auction-house",
    "trading",
    "gifting",
    "atomic-swap",
    "noncustodial"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@keicoin/core": "^0.5.0",
    "@keicoin/market": "^0.3.0"
  }
}
