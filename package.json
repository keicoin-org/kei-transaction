{
  "name": "kei-transaction-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build && tsc -p tsconfig.tests.json && tsc -p tsconfig.tests.dom.json",
    "test": "bun test",
    "test:m3-live": "bun test ./packages/kei/test/m3-live.ts",
    "release:check": "node scripts/check-release.mjs",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "happy-dom": "^20.0.0",
    "kei-transaction": "workspace:*",
    "typescript": "^5.9.0"
  }
}
